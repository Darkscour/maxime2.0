// ─────────────────────────────────────────────────────────────────────────
//  Maxime — Prisma schema
//  Defines every table in your Supabase Postgres database.
//
//  How to use:
//    1. Edit this file when you want to add/remove tables or columns.
//    2. Run `npx prisma migrate dev --name "what-changed"` to apply changes.
//    3. Run `npx prisma studio` to browse your data in a visual UI.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A player who can be scouted by an org.
// Mirrors the `Player` TypeScript type in src/lib/mock-data.ts so the UI
// keeps working unchanged when we swap mock data for real DB queries.
model Player {
  id           String   @id @default(cuid())
  handle       String   @unique
  avatarHue    Int
  game         String
  role         String
  rank         String
  region       String
  school       String?
  age          Int
  winRate      Float
  kda          Float
  hoursPerWeek Int
  fitScore     Int
  tags         String[] @default([])
  status       String   @default("Available")
  verified     Boolean  @default(false)

  // Where this profile originally came from. Useful when we add data from
  // PandaScore, Riot API, or direct user signups later.
  externalSrc String?
  externalId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([game])
  @@index([region])
  @@index([rank])
}

// A brand willing to sponsor amateur or collegiate orgs.
// Mirrors the `Sponsor` TypeScript type in src/lib/mock-data.ts.
model Sponsor {
  id             String   @id @default(cuid())
  name           String   @unique
  industry       String
  tier           String
  checkSize      String
  regions        String[] @default([])
  games          String[] @default([])
  audience       String
  applicationUrl String
  contact        String?
  description    String
  brandHue       Int
  active         Boolean  @default(true)

  // Where this sponsor record came from: "manual_curation" | "apify_scrape" |
  // "user_submission". Helps you trust newer entries appropriately.
  source         String   @default("manual_curation")
  lastVerifiedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@index([tier])
}

// ── Onboarding: accounts, teams, player profiles ─────────────────────────

// Links a Clerk user to Maxime — one row per signed-in person.
model UserAccount {
  id                 String   @id @default(cuid())
  clerkId            String   @unique
  email              String?
  displayName        String?
  accountType        String?  // "team_manager" | "player"
  onboardingComplete Boolean  @default(false)
  managerTitle       String?
  managerOrgEmail    String?
  managerVerificationStatus String? // "verified" | "pending"

  membership       TeamMembership?
  playerProfile    PlayerProfile?
  profileViewsMade PlayerProfileView[] @relation("ProfileViewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Org profile created by a captain / manager during team onboarding.
model Team {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  school             String?
  games              String[] @default([])
  region             String?
  rosterSize         Int?
  avgViewers         Int?
  discordUrl         String?
  inviteCode         String   @unique @default(cuid())
  onboardingComplete Boolean  @default(false)

  members            TeamMembership[]
  sponsorLeads       SponsorLead[]
  playerProfileViews PlayerProfileView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inviteCode])
}

// Connects a UserAccount to a Team (captain, manager, or player).
model TeamMembership {
  id     String @id @default(cuid())
  teamId String
  userId String @unique
  role   String // "captain" | "manager" | "player"
  status String @default("active")

  team Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

// Individual player profile — separate from scout-pool `Player` listings.
model PlayerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  handle       String   @unique
  game         String
  role         String
  rank         String
  region       String
  school       String?
  age          Int?
  hoursPerWeek Int?
  status       String   @default("Available")
  tags         String[] @default([])
  bio          String?

  user         UserAccount         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileViews PlayerProfileView[]
  playTimeLogs PlayerPlayTimeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([game])
  @@index([region])
}

// When a team manager (or scout) opens a player's profile.
model PlayerProfileView {
  id              String   @id @default(cuid())
  playerProfileId String
  viewerUserId    String
  viewerTeamId    String?
  createdAt       DateTime @default(now())

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  viewer        UserAccount   @relation("ProfileViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  viewerTeam    Team?         @relation(fields: [viewerTeamId], references: [id], onDelete: SetNull)

  @@index([playerProfileId, createdAt])
  @@index([viewerUserId])
  @@index([viewerTeamId])
}

// Snapshot each time a player logs or updates play time.
model PlayerPlayTimeLog {
  id              String   @id @default(cuid())
  playerProfileId String
  hoursPerWeek    Int
  createdAt       DateTime @default(now())

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([playerProfileId, createdAt])
}

// Team outreach tracking for a sponsor from Supabase (keyed by external sponsor ID).
model SponsorLead {
  id          String    @id @default(cuid())
  teamId      String
  sponsorId   String
  sponsorName String
  industry    String?
  difficulty  String?
  sponsorLink String?
  status      String    @default("saved")
  fitScore    Int?
  fitReason   String?
  notes       String?
  appliedAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, sponsorId])
  @@index([teamId])
  @@index([status])
}
